{
  // Tên này PHẢI giống hệt tên Worker trên Cloudflare (của con là "cetm")
  "name": "cetm",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "views",
      // Dán "Database ID" của D1 vào chỗ DAN-ID-VAO-DAY (giữ nguyên dấu ngoặc kép)
      "database_id": "2641969d-1bd8-47d9-84b2-50c50908e4ba"
    }
  ]
}
